+    sentinel = tmp_path / "outside-publication-sentinel"
+    sentinel.write_bytes(b"external bytes must remain")
+    sentinel_before = sentinel.stat()
+    with files.exclusive_writer(w.settings.media_root, "tmp/unsealed-source") as stream:
+        stream.write(b"unsealed source must remain")
+    prefixes = ("publications/frame-relay", "./publications/frame-relay", "publications//frame-relay",
+        "publications/./frame-relay", "publications/frame-relay/.", "Publications/Frame-Relay",
+        "PUBLICATIONS/FRAME-RELAY", "./Publications//Frame-Relay/.")
+    for prefix in prefixes:
+        existing = prefix + "/" + artifact.name
+        fresh = prefix + "/" + str(uuid4()) + ".media"
+        for relative in (prefix, existing, fresh):
+            with pytest.raises(StorageError, match="sealed"):
+                with files.exclusive_writer(w.settings.media_root, relative): pass
+            with pytest.raises(StorageError, match="sealed"):
+                files.publish(w.settings.media_root, relative, "tmp/publish-alias")
+            with pytest.raises(StorageError, match="sealed"):
