+            with pytest.raises(StorageError, match="sealed"):
+                files.remove_owned(w.settings.media_root, relative)
+        assert not (w.settings.media_root / fresh).exists()
+        assert not (w.settings.media_root / "tmp/publish-alias").exists()
+        assert artifact.read_bytes() == MOV
+        assert files.current_fingerprint(w.settings.media_root, item["path"]) == before
+        assert (w.settings.media_root / "tmp/unsealed-source").read_bytes() == b"unsealed source must remain"
+        assert sentinel.read_bytes() == b"external bytes must remain"
+        current = sentinel.stat()
+        assert (current.st_dev, current.st_ino, current.st_size, current.st_mtime_ns, current.st_ctime_ns) == (
