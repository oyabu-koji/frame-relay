+def module(name):
+    path = Path(__file__).with_name(name + ".py")
+    spec = importlib.util.spec_from_file_location("inventory_" + name, path)
+    value = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = value
+    spec.loader.exec_module(value)
+    return value
+
