+    private func startNDAnalysis(generation: CaptureGeneration) {
+        guard let policy = ndPolicy else { return }
+        ndSession = CaptureNDSession(context: .init(generation: generation, framingRevision: subjectFramingRevision,
+            selectionRevision: subjects?.context.selectionRevision ?? 0, whiteBalanceRevision: ndWhiteBalanceRevision,
