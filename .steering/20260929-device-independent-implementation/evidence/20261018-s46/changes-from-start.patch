+        observeNDWhiteBalance(); publishND()
+        ndTimer = Task { [weak self] in
+            while !Task.isCancelled {
+                do { try await Task.sleep(for: .milliseconds(100)) } catch { return }
+                await self?.expireND(generation: generation)
