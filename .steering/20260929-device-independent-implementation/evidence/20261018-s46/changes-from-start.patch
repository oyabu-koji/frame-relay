+
+    private func observeNDWhiteBalance() {
+        guard ndSession != nil, let device else { return }
+        let mode: CaptureNDWhiteBalance.Mode
+        switch device.whiteBalanceMode {
+        case .locked: mode = .locked
+        case .continuousAutoWhiteBalance: mode = .automatic
+        case .autoWhiteBalance: mode = .measuring
+        @unknown default: mode = .unknown
+        }
+        let gains = device.deviceWhiteBalanceGains
+        let value = CaptureNDWhiteBalance(mode: mode, red: Double(gains.redGain), green: Double(gains.greenGain), blue: Double(gains.blueGain))
+        guard value != ndWhiteBalance else { return }
+        ndWhiteBalance = value; ndWhiteBalanceRevision += 1; updateNDContext()
+    }
+
+    private func updateNDContext() {
+        guard let current = ndSession?.context else { return }
+        let next = CaptureNDContext(generation: current.generation, framingRevision: max(subjectFramingRevision, ndFramingRevision),
+            selectionRevision: subjects?.context.selectionRevision ?? current.selectionRevision,
+            whiteBalanceRevision: ndWhiteBalanceRevision, intent: ndIntent, analysisRevision: current.analysisRevision)
+        if next != current { ndSession?.update(next, now: ProcessInfo.processInfo.systemUptime); publishND() }
+    }
+
+    private func observeND(_ buffer: CVPixelBuffer, geometry: NativeCaptureSubjectGeometry, observedAt: TimeInterval) {
+        guard let policy = ndPolicy, let analysis = ndAnalysis else { return }
+        if let previous = ndGeometry, previous != geometry { ndFramingRevision += 1 }
+        ndGeometry = geometry
+        observeNDWhiteBalance(); updateNDContext()
+        guard let context = ndSession?.context else { return }
+        // The gain read above is current SDK state, not metadata on this frame.
+        // Reject delayed frames captured before the latest observed context change.
+        // Continuously changing Auto WB may keep advice pending; no gain tolerance
+        // or frame-specific WB correspondence is inferred here.
+        guard ndSession?.acceptsInput(observedAt: observedAt, now: ProcessInfo.processInfo.systemUptime) == true else {
+            invalidateNDInput(.stale); return
+        }
+        guard ndWhiteBalance?.isValid == true, ndWhiteBalance?.mode != .measuring else {
+            invalidateNDInput(.contextChanged); return
+        }
+        var targets: [NativeCaptureNDTarget] = []
+        let fresh = subjects?.analysisAvailable == true && subjects?.lastObservedAt.map {
+            observedAt >= $0 && observedAt - $0 <= policy.maximumSubjectAge
+        } == true
+        for id in ndExposureTargets {
+            if let person = subjects?.candidates.first(where: { $0.id == id }),
+               let bounds = geometry.normalizedOutputBounds(fromMetadata: person.bounds) {
+                targets.append(.init(person: id, bounds: bounds))
+            }
+        }
+        let complete = fresh && targets.count == ndExposureTargets.count
+        if ndIntent != .scenery, !ndExposureTargets.isEmpty, !complete {
+            invalidateNDInput(.missingPeople); return
+        }
+        ndSession?.willSubmitInput()
+        analysis.submit(buffer, instruction: .init(context: context, targets: targets, targetsAvailable: complete), observedAt: observedAt)
+    }
+
+    private func receiveND(_ result: CaptureNDResult) {
+        guard session?.isRunning == true, session?.isInterrupted != true else {
+            invalidateNDInput(.stopped); return
+        }
+        observeNDWhiteBalance(); updateNDContext()
+        guard result.context == ndSession?.context else { return }
+        if !currentNDTargetsAvailable(now: ProcessInfo.processInfo.systemUptime) {
+            invalidateNDInput(.missingPeople); return
+        }
+        _ = ndSession?.receive(result, now: ProcessInfo.processInfo.systemUptime)
+        publishND()
+    }
+
+    private func expireND(generation: CaptureGeneration) {
+        guard ndSession?.context.generation == generation else { return }
+        if session?.isRunning != true || session?.isInterrupted == true {
+            invalidateNDInput(.stopped)
+        } else if !currentNDTargetsAvailable(now: ProcessInfo.processInfo.systemUptime) {
+            invalidateNDInput(.missingPeople)
+        } else if ndSession?.expire(now: ProcessInfo.processInfo.systemUptime) == true { publishND() }
+    }
+
+    private func currentNDTargetsAvailable(now: TimeInterval) -> Bool {
+        guard ndIntent != .scenery, !ndExposureTargets.isEmpty else { return true }
+        guard let policy = ndPolicy, let subjects, subjects.analysisAvailable,
+              let observedAt = subjects.lastObservedAt, now >= observedAt, now - observedAt <= policy.maximumSubjectAge else { return false }
+        return ndExposureTargets.isSubset(of: Set(subjects.candidates.map(\.id)))
+    }
+
+    private func invalidateNDInput(_ reason: CaptureNDReason) {
+        guard let before = ndSession?.context else { return }
+        let advice = ndSession?.advice
+        ndSession?.invalidateInput(reason, now: ProcessInfo.processInfo.systemUptime)
+        if before != ndSession?.context || advice != ndSession?.advice { publishND() }
+    }
+
+    private func publishND() {
+        guard let ndSession else { return }
+        ndSequence += 1; ndContinuation.yield(ndSession.snapshot(sequence: ndSequence))
+    }
+
+    private func stopNDAnalysis() {
+        ndTimer?.cancel(); ndTimer = nil
+        ndWhiteBalanceObservations.forEach { $0.invalidate() }; ndWhiteBalanceObservations = []
+        ndAnalysis?.stop(); ndAnalysis = nil
+        ndSession?.invalidate(.stopped); publishND(); ndSession = nil
+        ndWhiteBalance = nil; ndIntent = nil; ndExposureTargets = []; ndGeometry = nil
+    }
+}
