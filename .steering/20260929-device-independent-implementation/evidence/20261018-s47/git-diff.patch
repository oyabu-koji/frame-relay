+        subjects?.invalidateFraming(subjectFramingRevision)
+        ndExposureTargets = []; ndFramingRevision += 1; updateNDContext()
+        configureSubjectAnalysis(); applySubjectFocus(); publishSubjects()
+    }
+
+    private func stopSubjectAnalysis() {
+        stopNDAnalysis()
