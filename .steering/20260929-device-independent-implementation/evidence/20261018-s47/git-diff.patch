+            height: CVPixelBufferGetHeight(buffer), rotation: connection.videoRotationAngle,
+            mirrored: connection.isVideoMirrored, convertPixels: { output.metadataOutputRectConverted(fromOutputRect: $0) }) else {
+            invalidateNDInput(.insufficientSignal); return
+        }
+        guard let clock = session?.synchronizationClock else { invalidateNDInput(.insufficientSignal); return }
+        let pts = CMSampleBufferGetPresentationTimeStamp(sample)
+        let clockTime = CMClockGetTime(clock)
+        guard pts.isNumeric, clockTime.isNumeric, pts.epoch == clockTime.epoch,
+              let observedAt = NativeCaptureSubjectGeometry.observedAt(presentationSeconds: CMTimeGetSeconds(pts),
