+        guard session?.isRunning == true, session?.isInterrupted != true else { invalidateNDInput(.stopped); return }
+        guard let connection = output.connection(with: .video), connection.isActive, connection.isEnabled,
+              connection.videoRotationAngle == 0, !connection.isVideoMirrored,
+              CMSampleBufferDataIsReady(sample), let buffer = CMSampleBufferGetImageBuffer(sample) else {
+            invalidateNDInput(.insufficientSignal); return
