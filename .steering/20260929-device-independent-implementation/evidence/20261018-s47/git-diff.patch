+
+    private func expireSubjects(generation: CaptureGeneration) {
+        guard subjects?.context.generation == generation, let policy = subjectPolicy else { return }
+        let now = ProcessInfo.processInfo.systemUptime
+        if subjects?.lastObservedAt == nil, let started = subjectAnalysisStartedAt,
+           now - started > policy.maximumResultAge, subjects?.state == .detecting {
+            subjects?.invalidateAnalysis(now: now)
+        } else if subjects?.expire(now: now) != true { return }
