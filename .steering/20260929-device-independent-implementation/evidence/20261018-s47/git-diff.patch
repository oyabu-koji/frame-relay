+        output.alwaysDiscardsLateVideoFrames = true
+        configureSubjectCoordinates(output.connection(with: .video))
+        let delegate = NativeCaptureSubjectSampleDelegate(owner: self)
+        output.setSampleBufferDelegate(delegate, queue: queue)
+        subjectVideoOutput = output; subjectDelegate = delegate
+    }
+
+    private func startSubjectAnalysis(generation: CaptureGeneration) {
+        guard let policy = subjectPolicy else { return }
+        subjects = CaptureSubjectSession(context: .init(generation: generation,
+            framingRevision: subjectFramingRevision, selectionRevision: 0), policy: policy)
+        subjectAnalysisStartedAt = ProcessInfo.processInfo.systemUptime
+        subjectAnalysis = NativeCaptureSubjectAnalysis(policy: policy) { [weak self] result in
+            Task { await self?.receiveSubjectAnalysis(result) }
+        }
+        configureSubjectAnalysis()
+        applySubjectFocus()
+        publishSubjects()
+        subjectTimer?.cancel()
+        subjectTimer = Task { [weak self] in
+            while !Task.isCancelled {
+                do { try await Task.sleep(for: .milliseconds(200)) } catch { return }
+                await self?.expireSubjects(generation: generation)
+            }
+        }
+    }
+
+    func updateSubjects(_ request: CaptureSubjectRequest) -> CaptureSubjectSnapshot? {
+        guard session?.isRunning == true, session?.isInterrupted != true,
+              subjects?.command(request, now: ProcessInfo.processInfo.systemUptime) != nil else { return nil }
+        ndExposureTargets = subjects?.exposureTargets ?? []
+        updateNDContext()
+        configureSubjectAnalysis(); applySubjectFocus(); publishSubjects()
+        return subjects?.snapshot(sequence: subjectSequence, focus: subjectFocus)
