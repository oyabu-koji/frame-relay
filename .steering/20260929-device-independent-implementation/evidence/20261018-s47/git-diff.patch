+    }
+
+    private func invalidateSubjectWhiteBalance() {
+        ndWhiteBalanceRevision += 1; updateNDContext()
+        guard subjects != nil else { return }
+        subjects?.invalidateWhiteBalance(now: ProcessInfo.processInfo.systemUptime)
+        configureSubjectAnalysis(); applySubjectFocus(); publishSubjects()
+    }
+
+    private func configureSubjectAnalysis() {
+        guard let subjects else { return }
+        subjectAnalysis?.configure(.init(context: subjects.context, protagonist: subjects.protagonist,
+            allowsReacquisition: subjects.state != .heldAwaitingSelection))
+    }
+
+    private func applySubjectFocus() {
+        guard let subjects, let device else { subjectFocus = .unconfirmed; return }
+        subjectFocus = NativeCaptureSubjectFocus.apply(subjects.action, to: device)
+    }
+
+    private func publishSubjects() {
+        guard let subjects else { return }
+        subjectSequence += 1
+        subjectContinuation.yield(subjects.snapshot(sequence: subjectSequence, focus: subjectFocus))
+    }
+
+    private func updateSubjectFraming(_ value: CaptureStabilizationSnapshot) {
+        guard let previous = latestStabilization else { return }
+        guard value.generation != previous.generation || value.camera != previous.camera
+            || value.activePhysicalCamera != previous.activePhysicalCamera || value.formatID != previous.formatID
+            || value.width != previous.width || value.height != previous.height || value.zoom != previous.zoom
+            || value.activeMode.value != previous.activeMode.value || value.requestedMode != previous.requestedMode
+            || value.preferredMode != previous.preferredMode
+            || value.connection != previous.connection else { return }
