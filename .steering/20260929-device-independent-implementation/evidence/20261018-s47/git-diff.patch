+
+    private func receiveSubjectAnalysis(_ result: CaptureSubjectAnalysis) {
+        guard session?.isRunning == true, session?.isInterrupted != true,
+              subjects?.receive(result, now: ProcessInfo.processInfo.systemUptime) == true else { return }
+        if !currentNDTargetsAvailable(now: ProcessInfo.processInfo.systemUptime) { invalidateNDInput(.missingPeople) }
