 extension NativeExplorationCapture {
+    private func startZoomObservation(generation: CaptureGeneration) throws {
+        clearZoomObservation()
+        guard zoomPolicy != nil, let preparation, let device else { return }
+        zoomDesired = preparation.desired
+        if device.isVirtualDevice {
+            if device.isPrimaryConstituentDeviceSwitchingBehaviorLockedWithDeviceSupported,
+               let active = device.activePrimaryConstituent {
+                let beforeZoom = device.videoZoomFactor
+                let beforeISO = active.iso
+                let beforeDuration = active.exposureDuration
+                let beforeAperture = active.lensAperture
+                try device.lockForConfiguration()
+                device.setPrimaryConstituentDeviceSwitchingBehaviorLockedWith(active)
+                device.unlockForConfiguration()
+                guard device.activePrimaryConstituent === active, device.videoZoomFactor == beforeZoom,
+                      active.iso == beforeISO, active.exposureDuration == beforeDuration,
+                      active.lensAperture == beforeAperture,
+                      device.activePrimaryConstituentDeviceSwitchingBehavior == .locked else {
+                    throw ExplorationIssue.capabilityUnconfirmed("initial_lens_lock_changed_values")
+                }
+                lockedLensID = active.uniqueID
+            } else { lensConstraint = "lens_lock_unsupported" }
+        }
+        if let effective = NativeCaptureLens.effectiveDevice(device), NativeCaptureLens.isManual(effective) {
+            lensBaseline = .init(iso: Double(effective.iso), aperture: Double(effective.lensAperture),
+                                 manualRevision: lensExposureOrder.manualRevision)
+        }
+        let changed: @Sendable () -> Void = { [weak self] in
+            Task { await self?.zoomSDKChanged(generation: generation) }
+        }
+        zoomObservations = [
+            device.observe(\.isRampingVideoZoom, options: [.new]) { _, _ in changed() },
+            device.observe(\.minAvailableVideoZoomFactor, options: [.new]) { _, _ in changed() },
+            device.observe(\.maxAvailableVideoZoomFactor, options: [.new]) { _, _ in changed() },
+            device.observe(\.activePrimaryConstituentDeviceSwitchingBehavior, options: [.new]) { _, _ in changed() }
+        ]
+        // Effective physical values can differ from the virtual device's values
+        // after an explicit constituent lock (SDK27 contract).
+        for camera in device.isVirtualDevice ? device.constituentDevices : [device] {
+            zoomObservations += [
+                camera.observe(\.iso, options: [.new]) { _, _ in changed() },
+                camera.observe(\.exposureDuration, options: [.new]) { _, _ in changed() },
+                camera.observe(\.lensAperture, options: [.new]) { _, _ in changed() },
+                camera.observe(\.exposureMode, options: [.new]) { _, _ in changed() }
+            ]
+        }
