+def evaluate_test_metadata(summary, test_results):
+    """Fail closed on zero, missing, duplicate, skipped or unexpected test cases."""
+    cases = []
+
+    def visit(node):
+        if not isinstance(node, dict):
+            raise RuntimeError("Unexpected xcresult test node shape")
+        if node.get("nodeType") == "Test Case":
+            cases.append({"identifier": node.get("nodeIdentifier"), "result": node.get("result")})
+        for child in node.get("children", []):
+            visit(child)
+
+    for node in test_results.get("testNodes", []):
+        visit(node)
+    fields = ("totalTestCount", "passedTests", "failedTests", "skippedTests", "expectedFailures")
+    counts = {key: summary.get(key) for key in fields}
+    devices = summary.get("devicesAndConfigurations", [])
+    expected = {test.removeprefix("FrameRelayTests/") for test in EXPECTED_TESTS}
+    identifiers = [case["identifier"] for case in cases]
+    passed = (summary.get("result") == "Passed" and
+        all(type(value) is int for value in counts.values()) and
+        counts == {"totalTestCount": 6, "passedTests": 6, "failedTests": 0,
+                   "skippedTests": 0, "expectedFailures": 0} and
+        len(devices) == 1 and
+        devices[0].get("device", {}).get("deviceId") == DESTINATION.split("id=", 1)[1] and
+        all(type(devices[0].get(key)) is int and devices[0][key] == count
+            for key, count in (("passedTests", 6), ("failedTests", 0),
+                               ("skippedTests", 0), ("expectedFailures", 0))) and
+        len(cases) == 6 and set(identifiers) == expected and
+        all(case["result"] == "Passed" for case in cases))
+    return {"passed": passed, "counts": counts, "expected_tests": list(EXPECTED_TESTS),
+            "test_cases": cases, "device_configuration_count": len(devices)}
+
+
+def read_test_metadata(bundle, environment):
+    # Never pass TEST_RUNNER_* credentials to xcresulttool or export attachments/logs.
+    metadata_environment = {key: value for key, value in environment.items()
+                            if not key.startswith("TEST_RUNNER_")}
+    documents = []
+    for kind in ("summary", "tests"):
+        command = ["/usr/bin/xcrun", "xcresulttool", "get", "test-results", kind,
+                   "--path", str(bundle)]
+        result = subprocess.run(command, env=metadata_environment, stdin=subprocess.DEVNULL,
+            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=10, check=True)
+        if len(result.stdout) > 2 * 1024 * 1024:
+            raise RuntimeError("Unexpected xcresult metadata size")
+        documents.append(json.loads(result.stdout))
+    return evaluate_test_metadata(*documents)
 
 
