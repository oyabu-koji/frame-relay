+def verify_external_runtime(original):
+    site = Path(original["site_packages_root"])
+
+    def dependency_record(path):
+        if path.is_symlink():
+            return {"kind": "symlink", "target": os.readlink(path),
+                    "resolved": str(path.resolve(strict=True))}
+        return record(path)
+
