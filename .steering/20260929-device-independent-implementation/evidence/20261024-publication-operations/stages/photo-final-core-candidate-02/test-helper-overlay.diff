+/// Only controlled test fakes use the legacy branch. Native and the protocol
+/// default have no legacy fallback. An empty synchronous action is a fake
+/// boundary observation, never proof of PhotoKit invocation or completion.
+nonisolated func photoSaveFakeStart(_ command: PhotoLibraryAddCommand,
+                                   start: PhotoSaveStartAuthorization) async -> PhotoSaveStartDisposition {
