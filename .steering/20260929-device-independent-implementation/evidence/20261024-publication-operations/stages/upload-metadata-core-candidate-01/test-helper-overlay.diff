+nonisolated private final class MetadataDispatchCounter: Sendable {
+    private let count = OSAllocatedUnfairLock(initialState: 0)
+    func increment() { count.withLock { $0 += 1 } }
+    var value: Int { count.withLock { $0 } }
+}
