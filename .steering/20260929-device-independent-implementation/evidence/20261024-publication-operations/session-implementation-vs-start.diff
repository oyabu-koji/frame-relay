+            preparedBatch.removeValue(forKey: operation)
+        }
+        guard capture.snapshot().isHeld, preparationGeneration == generation else { return false }
+        // Existing preparations may still be resuming their driver continuation;
+        // their old generation can only join cleanup, never cache/start again.
+        return !preparing.values.contains(where: { $0.generation >= generation })
