+    /// REC's synchronous shared hold is already installed. Drain only retained
+    /// preparation/capabilities, without changing the person's cancelled set or
+    /// waiting for a driver that is itself waiting for capture to end.
+    func stopLiveStartsForCapture() async -> Bool {
+        guard capture.snapshot().isHeld, !preparationExhausted else { return false }
+        guard preparationGeneration != UInt64.max else { preparationExhausted = true; return false }
+        preparationGeneration += 1
