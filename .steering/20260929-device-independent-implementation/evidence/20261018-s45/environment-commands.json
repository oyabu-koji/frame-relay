[
  [
    "environment",
    [
      "xcodebuild",
      "-version"
    ]
  ],
  [
    "swift",
    [
      "xcrun",
      "swift",
      "--version"
    ]
  ],
  [
    "list",
    [
      "xcodebuild",
      "-list",
      "-project",
      "FrameRelay.xcodeproj"
    ]
  ],
  [
    "destinations",
    [
      "xcodebuild",
      "-project",
      "FrameRelay.xcodeproj",
      "-scheme",
      "FrameRelay",
      "-showdestinations"
    ]
  ],
  [
    "test-plans",
    [
      "xcodebuild",
      "-project",
      "FrameRelay.xcodeproj",
      "-scheme",
      "FrameRelay",
      "-showTestPlans"
    ]
  ],
  [
    "devices",
    [
      "xcrun",
      "simctl",
      "list",
      "devices",
      "available",
      "-j"
    ]
  ]
]
