+extension NativeExplorationCapture {
+    private func configureSubjectCoordinates(_ connection: AVCaptureConnection?) {
+        guard subjectPolicy != nil, let connection else { return }
+        if connection.isVideoRotationAngleSupported(0) { connection.videoRotationAngle = 0 }
+        if connection.isVideoMirroringSupported {
+            connection.automaticallyAdjustsVideoMirroring = false
+            connection.isVideoMirrored = false
+        }
+    }
+
+    private func configureSubjectOutput(_ captureSession: AVCaptureSession) {
+        let output = AVCaptureVideoDataOutput()
+        guard captureSession.canAddOutput(output) else { return }
+        captureSession.addOutput(output)
+        output.automaticallyConfiguresOutputBufferDimensions = false
+        output.deliversPreviewSizedOutputBuffers = true
+        output.alwaysDiscardsLateVideoFrames = true
+        configureSubjectCoordinates(output.connection(with: .video))
+        let delegate = NativeCaptureSubjectSampleDelegate(owner: self)
+        output.setSampleBufferDelegate(delegate, queue: queue)
+        subjectVideoOutput = output; subjectDelegate = delegate
+    }
+
+    private func startSubjectAnalysis(generation: CaptureGeneration) {
+        guard let policy = subjectPolicy else { return }
+        subjects = CaptureSubjectSession(context: .init(generation: generation,
+            framingRevision: subjectFramingRevision, selectionRevision: 0), policy: policy)
+        subjectAnalysisStartedAt = ProcessInfo.processInfo.systemUptime
+        subjectAnalysis = NativeCaptureSubjectAnalysis(policy: policy) { [weak self] result in
+            Task { await self?.receiveSubjectAnalysis(result) }
+        }
+        configureSubjectAnalysis()
+        applySubjectFocus()
+        publishSubjects()
+        subjectTimer?.cancel()
+        subjectTimer = Task { [weak self] in
+            while !Task.isCancelled {
+                do { try await Task.sleep(for: .milliseconds(200)) } catch { return }
+                await self?.expireSubjects(generation: generation)
+            }
+        }
+    }
+
+    func updateSubjects(_ request: CaptureSubjectRequest) -> CaptureSubjectSnapshot? {
+        guard session?.isRunning == true, session?.isInterrupted != true,
+              subjects?.command(request, now: ProcessInfo.processInfo.systemUptime) != nil else { return nil }
+        configureSubjectAnalysis(); applySubjectFocus(); publishSubjects()
+        return subjects?.snapshot(sequence: subjectSequence, focus: subjectFocus)
+    }
+
+    fileprivate func isCurrentVideoOutput(_ output: AVCaptureOutput) -> Bool { output === videoOutput }
+
+    fileprivate func observeSubjects(_ sample: CMSampleBuffer, output: AVCaptureOutput) {
+        guard let subjectAnalysis, output === subjectVideoOutput || output === videoOutput,
+              session?.isRunning == true, session?.isInterrupted != true,
+              let connection = output.connection(with: .video), connection.isActive, connection.isEnabled,
+              connection.videoRotationAngle == 0, !connection.isVideoMirrored,
+              CMSampleBufferDataIsReady(sample), let buffer = CMSampleBufferGetImageBuffer(sample) else { return }
+        guard let geometry = NativeCaptureSubjectGeometry.capture(width: CVPixelBufferGetWidth(buffer),
+            height: CVPixelBufferGetHeight(buffer), rotation: connection.videoRotationAngle,
+            mirrored: connection.isVideoMirrored, convertPixels: { output.metadataOutputRectConverted(fromOutputRect: $0) }) else { return }
+        guard let clock = session?.synchronizationClock, let policy = subjectPolicy else { return }
+        let pts = CMSampleBufferGetPresentationTimeStamp(sample)
+        let clockTime = CMClockGetTime(clock)
+        guard pts.isNumeric, clockTime.isNumeric, pts.epoch == clockTime.epoch,
+              let observedAt = NativeCaptureSubjectGeometry.observedAt(presentationSeconds: CMTimeGetSeconds(pts),
+                clockSeconds: CMTimeGetSeconds(clockTime), uptime: ProcessInfo.processInfo.systemUptime,
+                maximumAge: policy.maximumResultAge) else { return }
+        subjectAnalysis.submit(buffer, geometry: geometry, observedAt: observedAt)
+    }
+
+    private func receiveSubjectAnalysis(_ result: CaptureSubjectAnalysis) {
+        guard session?.isRunning == true, session?.isInterrupted != true,
+              subjects?.receive(result, now: ProcessInfo.processInfo.systemUptime) == true else { return }
+        configureSubjectAnalysis(); applySubjectFocus(); publishSubjects()
+    }
+
+    private func expireSubjects(generation: CaptureGeneration) {
+        guard subjects?.context.generation == generation, let policy = subjectPolicy else { return }
+        let now = ProcessInfo.processInfo.systemUptime
+        if subjects?.lastObservedAt == nil, let started = subjectAnalysisStartedAt,
+           now - started > policy.maximumResultAge, subjects?.state == .detecting {
+            subjects?.invalidateAnalysis(now: now)
+        } else if subjects?.expire(now: now) != true { return }
+        configureSubjectAnalysis(); applySubjectFocus(); publishSubjects()
+    }
+
+    private func invalidateSubjectWhiteBalance() {
+        guard subjects != nil else { return }
+        subjects?.invalidateWhiteBalance(now: ProcessInfo.processInfo.systemUptime)
+        configureSubjectAnalysis(); applySubjectFocus(); publishSubjects()
+    }
+
+    private func configureSubjectAnalysis() {
+        guard let subjects else { return }
+        subjectAnalysis?.configure(.init(context: subjects.context, protagonist: subjects.protagonist,
+            allowsReacquisition: subjects.state != .heldAwaitingSelection))
+    }
+
+    private func applySubjectFocus() {
+        guard let subjects, let device else { subjectFocus = .unconfirmed; return }
+        subjectFocus = NativeCaptureSubjectFocus.apply(subjects.action, to: device)
+    }
+
+    private func publishSubjects() {
+        guard let subjects else { return }
+        subjectSequence += 1
+        subjectContinuation.yield(subjects.snapshot(sequence: subjectSequence, focus: subjectFocus))
+    }
+
+    private func updateSubjectFraming(_ value: CaptureStabilizationSnapshot) {
+        guard let previous = latestStabilization else { return }
+        guard value.generation != previous.generation || value.camera != previous.camera
+            || value.activePhysicalCamera != previous.activePhysicalCamera || value.formatID != previous.formatID
+            || value.width != previous.width || value.height != previous.height || value.zoom != previous.zoom
+            || value.activeMode.value != previous.activeMode.value || value.requestedMode != previous.requestedMode
+            || value.preferredMode != previous.preferredMode
+            || value.connection != previous.connection else { return }
+        subjectFramingRevision += 1
+        subjects?.invalidateFraming(subjectFramingRevision)
+        configureSubjectAnalysis(); applySubjectFocus(); publishSubjects()
+    }
+
+    private func stopSubjectAnalysis() {
+        subjectTimer?.cancel(); subjectTimer = nil
+        subjectAnalysis?.stop(); subjectAnalysis = nil
+        subjectVideoOutput?.setSampleBufferDelegate(nil, queue: nil)
+        subjectVideoOutput = nil; subjectDelegate = nil; subjects = nil
+        subjectFocus = .unconfirmed; subjectAnalysisStartedAt = nil
+    }
